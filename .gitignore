# Ignore mdbook output
book/

# Ignore Gemini temporary files
.gemini/

# Ignore Zone.Identifier files
*:Zone.Identifier

# Ignore DDMA scratch & temporary build folders
ddma/scratch/
ddma/build_temp/
ddma/clips/
ddma/previews/
ddma/docs/assets/clips/
ddma/docs/episodes/*/clips/
ddma/**/__pycache__/
ddma/*.png
ddma/*.mp4

# Ignore intermediate/raw video clip build artifacts
*-original.mp4

# Ingestion Layer (Pillar 2) Temporary Buffers & Payloads
ingest/payloads/
ingest/scratch/
ingest/backups/
ingest/temp/
ingest/__pycache__/
ingest/*.pyc
scratch/
*.bak
*.py.bak
extract.py
payload_*.py